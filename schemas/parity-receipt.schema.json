{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equaltrace.dev/schemas/parity-receipt.schema.json",
  "title": "EqualTrace deterministic parity receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "applicationVersion",
    "scenario",
    "finalOutcome",
    "outcomeParity",
    "routes",
    "assertions",
    "repair",
    "verdict",
    "receiptId"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "applicationVersion": { "type": "string", "minLength": 1 },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "seed", "requestedOutcome", "initialState"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "seed": { "type": "string", "minLength": 1 },
        "requestedOutcome": { "const": "account_deleted" },
        "initialState": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accountId", "status"],
          "properties": {
            "accountId": { "type": "string", "minLength": 1 },
            "status": { "const": "active" }
          }
        }
      }
    },
    "finalOutcome": { "const": "account_deleted" },
    "outcomeParity": { "const": true },
    "routes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/route" }
    },
    "assertions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/assertion" }
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repairId", "repairDigest"],
      "properties": {
        "repairId": { "type": "string", "minLength": 1 },
        "repairDigest": { "type": "string", "minLength": 1 }
      }
    },
    "verdict": { "const": "pass" },
    "receiptId": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "runId", "source", "evidenceIds"],
      "properties": {
        "route": { "enum": ["visual", "assistive", "agent"] },
        "runId": { "type": "string", "minLength": 1 },
        "source": { "enum": ["pointer", "keyboard", "webmcp"] },
        "evidenceIds": {
          "type": "array",
          "minItems": 6,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "invariant", "checkpoint", "passed", "evidenceIds"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 6 },
        "invariant": {
          "enum": ["disclosure", "consent", "feedback", "reversibility", "recovery", "outcome"]
        },
        "checkpoint": { "type": "string", "minLength": 1 },
        "passed": { "const": true },
        "evidenceIds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
